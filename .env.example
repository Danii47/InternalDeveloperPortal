# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in every value before running docker compose.
# ─────────────────────────────────────────────────────────────────────────────

# ── Proxmox cluster ───────────────────────────────────────────────────────────
PROXMOX_URL=https://192.168.10.10:8006
PROXMOX_TOKEN_ID=root@pam!idp-token
PROXMOX_SECRET_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# El token necesita privilegios para gestionar VMs/pools/SDN/grupos. Lo más simple: rol
# "Administrator" en "/". IMPORTANTE: si el token tiene "privilege separation" activada NO hereda
# los permisos del usuario → desactívala o asígnale el rol (si no, verás 403 Pool.Allocate, etc.).

# ── TLS hacia Proxmox ─────────────────────────────────────────────────────────
# Por defecto NO se verifica el certificado (autofirmado). En producción, pon "true"
# y, si usas una CA propia, indica su ruta (montada en el contenedor). Afecta a la API,
# a la consola web y a Terraform.
IDP_PROXMOX_VERIFY=false
# IDP_PROXMOX_CA=/etc/ssl/certs/proxmox-ca.pem

# ── Backend JWT ───────────────────────────────────────────────────────────────
# Generate a strong key: python3 -c "import secrets; print(secrets.token_hex(32))"
IDP_SECRET_KEY=change-me-to-a-long-random-hex-string

# Set to true only when serving the frontend over HTTPS (enables Secure cookie flag)
IDP_SECURE_COOKIE=false

# ── CORS — must match the browser-visible frontend URL (port 80) ──────────────
IDP_ALLOWED_ORIGIN=http://192.168.10.201

# ── Frontend build — URL the browser uses to reach the FastAPI backend ────────
# This is baked into client-side JS bundles at `docker compose build` time.
# If your server IP changes, run `docker compose build frontend` to rebuild.
PUBLIC_API_URL=http://192.168.10.201:8000/api
