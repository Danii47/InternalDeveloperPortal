# ─────────────────────────────────────────────────────────────────────────────
# Proxmox IDP — Frontend (Astro SSR, Node standalone adapter)
# Two-stage build: builder compiles the app; runner is a lean production image.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app

# Install pnpm (lockfile version 9 → pnpm 9.x)
RUN npm install -g pnpm@^9

# ── Dependency install ────────────────────────────────────────────────────────
# Copy only the manifest files first for better layer cache reuse.
# pnpm-workspace.yaml is deliberately excluded here: the file has no `packages`
# field, which causes pnpm 9 to abort in workspace mode.
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# ── Source + build ────────────────────────────────────────────────────────────
# PUBLIC_API_URL is the URL the *browser* uses to call the backend API.
# It is baked into client-side JS at build time — changing it requires a rebuild.
ARG PUBLIC_API_URL=http://localhost:8000/api
ENV PUBLIC_API_URL=${PUBLIC_API_URL}

# Copy full source, then remove pnpm-workspace.yaml and run the build in one
# atomic RUN layer. Merging both commands guarantees the file is gone before
# pnpm evaluates the project; no intermediate layer can expose it.
COPY . .
RUN rm -f pnpm-workspace.yaml && pnpm build

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app

# Copy only the artefacts the production server needs
COPY --from=builder /app/dist         ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

# BACKEND_URL is the server-side URL used by Astro SSR (middleware + page fetches).
# Set to the Docker-internal service name so traffic never leaves the bridge network.
ENV BACKEND_URL=http://backend:8000
ENV HOST=0.0.0.0
ENV PORT=4321

EXPOSE 4321

# Entry point generated by @astrojs/node in standalone mode
CMD ["node", "./dist/server/entry.mjs"]
