---
import '../styles/global.css';
import '../styles/ui.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
const pathname = new URL(Astro.url).pathname;
const user = Astro.locals.user;
const isAdmin = user?.realm === 'pam';
---

<!doctype html>
<html lang="es" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="bg-slate-950 text-slate-300 min-h-screen font-sans antialiased selection:bg-blue-500/30">
		<nav class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50">
			<div class="max-w-[1760px] mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex items-center justify-between h-16">
					<div class="flex items-center gap-8">
						<div class="flex items-center gap-3">
							<div class="bg-blue-600 p-1.5 rounded-lg shadow-lg shadow-blue-900/20">
								<svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path></svg>
							</div>
							<span class="text-white text-lg font-bold tracking-tight">Proxmox IDP</span>
						</div>

						<div class="hidden md:flex items-center gap-1">
							<a href="/" class={`px-4 py-2 rounded-lg text-sm font-medium transition-all ${pathname === '/' ? 'bg-slate-800 text-blue-400' : 'text-slate-400 hover:text-white hover:bg-slate-800/50'}`}>
								🚀 Provisionamiento
							</a>
							<a href="/resources" class={`px-4 py-2 rounded-lg text-sm font-medium transition-all ${pathname === '/resources' ? 'bg-slate-800 text-blue-400' : 'text-slate-400 hover:text-white hover:bg-slate-800/50'}`}>
								📦 Inventario Flota
							</a>
							{isAdmin && (
								<a href="/admin/blueprints" class={`px-4 py-2 rounded-lg text-sm font-medium transition-all ${pathname === '/admin/blueprints' ? 'bg-slate-800 text-blue-400' : 'text-slate-400 hover:text-white hover:bg-slate-800/50'}`}>
									🧩 Blueprints
								</a>
							)}
							{isAdmin && (
								<a href="/admin/tenancy" class={`px-4 py-2 rounded-lg text-sm font-medium transition-all ${pathname === '/admin/tenancy' ? 'bg-slate-800 text-blue-400' : 'text-slate-400 hover:text-white hover:bg-slate-800/50'}`}>
									🏷️ Pools y Grupos
								</a>
							)}
						</div>
					</div>

					<div class="flex items-center gap-3">
						<span class="flex items-center gap-2 bg-slate-800/50 px-3 py-1.5 rounded-full text-xs font-medium text-slate-400 border border-slate-700/50">
							<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
							{user?.userid ?? 'Conectado'}
						</span>
						<button
							id="logoutBtn"
							class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800 border border-slate-700/50 transition-all"
						>
							Salir
						</button>
					</div>
				</div>
			</div>
		</nav>

		<main class="max-w-[1760px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
			<slot />
		</main>
	</body>
</html>

<script>
  import { API_URL } from '../lib/api.ts';

  document.getElementById('logoutBtn')?.addEventListener('click', async () => {
    await fetch(`${API_URL}/auth/logout`, { method: 'POST', credentials: 'include' }).catch(() => {});
    window.location.href = '/login';
  });
</script>