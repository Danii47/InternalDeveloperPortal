---
import Layout from '../layouts/Layout.astro';
import QuotaWidget from '../components/widgets/QuotaWidget.astro';
import AdminQuotasPanel from '../components/widgets/AdminQuotasPanel.astro';

const isAdmin = Astro.locals.user?.realm === 'pam';
---

<Layout title="Cuotas | Proxmox IDP">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-white">Cuotas de Recursos</h1>
    <p class="text-sm text-slate-400">
      {isAdmin
        ? 'Consumo de tu pool y gestión de los límites de todos los pools del clúster.'
        : 'Consumo y límites de recursos de tu pool.'}
    </p>
  </div>

  <!-- Cuota propia (todos los usuarios) -->
  <QuotaWidget />

  {isAdmin && (
    <div class="mt-8 pt-6 border-t border-slate-800">
      <AdminQuotasPanel />
    </div>
  )}
</Layout>
