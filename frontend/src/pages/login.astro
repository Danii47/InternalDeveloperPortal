---
import '../styles/global.css';
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Login | Proxmox IDP</title>
  </head>
  <body class="bg-slate-950 text-slate-300 min-h-screen flex items-center justify-center font-sans antialiased selection:bg-blue-500/30">

    <div class="w-full max-w-md px-4">

      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-14 h-14 bg-blue-600 rounded-2xl shadow-lg shadow-blue-900/30 mb-4">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-white">Proxmox IDP</h1>
        <p class="text-slate-400 text-sm mt-1">Internal Developer Platform</p>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl p-8">
        <h2 class="text-lg font-semibold text-white mb-6">Iniciar sesión</h2>

        <div id="errorBanner" class="hidden mb-5 px-4 py-3 rounded-lg bg-red-500/10 border border-red-500/30 text-sm text-red-400"></div>

        <form id="loginForm" class="space-y-5">
          <div>
            <label for="username" class="block text-sm font-medium text-slate-400 mb-1.5">Usuario</label>
            <input
              type="text" id="username" required autocomplete="username" placeholder="daniel"
              class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"
            />
          </div>

          <div>
            <label for="realm" class="block text-sm font-medium text-slate-400 mb-1.5">Realm</label>
            <select
              id="realm"
              class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:ring-2 focus:ring-blue-500 outline-none transition-all"
            >
              <option value="pve">pve — Proxmox VE</option>
              <option value="pam">pam — Linux PAM</option>
            </select>
          </div>

          <div>
            <label for="password" class="block text-sm font-medium text-slate-400 mb-1.5">Contraseña</label>
            <input
              type="password" id="password" required autocomplete="current-password" placeholder="••••••••"
              class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"
            />
          </div>

          <button
            type="submit" id="submitBtn"
            class="w-full bg-blue-600 hover:bg-blue-500 disabled:bg-slate-700 disabled:cursor-not-allowed text-white font-semibold py-2.5 px-4 rounded-lg transition-colors flex justify-center items-center gap-2"
          >
            <span id="submitText">Entrar</span>
          </button>
        </form>
      </div>
    </div>

  </body>
</html>

<script>
  import { API_URL } from '@/lib/api.ts';

  const form       = document.getElementById('loginForm') as HTMLFormElement;
  const submitBtn  = document.getElementById('submitBtn') as HTMLButtonElement;
  const submitText = document.getElementById('submitText') as HTMLElement;
  const errorBanner = document.getElementById('errorBanner') as HTMLElement;

  function showError(msg: string) {
    errorBanner.textContent = msg;
    errorBanner.classList.remove('hidden');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBanner.classList.add('hidden');

    const username = (document.getElementById('username') as HTMLInputElement).value.trim();
    const realm    = (document.getElementById('realm')    as HTMLSelectElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;

    submitBtn.disabled = true;
    submitText.textContent = 'Verificando...';

    try {
      const res = await fetch(`${API_URL}/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ username, realm, password }),
      });

      if (res.ok) {
        window.location.href = '/';
      } else {
        const data = await res.json().catch(() => ({}));
        showError(data.detail ?? 'Credenciales incorrectas. Verifica tu usuario y contraseña.');
      }
    } catch {
      showError('No se pudo conectar con el servidor. Verifica que el backend esté activo.');
    } finally {
      submitBtn.disabled = false;
      submitText.textContent = 'Entrar';
    }
  });
</script>
