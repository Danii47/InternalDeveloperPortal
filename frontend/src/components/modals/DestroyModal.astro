---
// Confirmation dialog for VM destruction.
// Opened via window.handleDestroy(vmName, vmid, node) defined in resources.astro.
---

<dialog
  id="destroyModal"
  class="bg-slate-900 text-slate-300 rounded-xl border border-slate-800 shadow-2xl p-0
         backdrop:bg-black/70 backdrop:backdrop-blur-sm w-full max-w-md m-auto
         open:animate-in open:fade-in-90 open:zoom-in-95"
>
  <div class="p-6">
    <div class="flex items-center gap-4 mb-4">
      <div class="w-10 h-10 rounded-full bg-red-500/10 flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-white">Confirmar Destrucción</h3>
    </div>

    <p class="text-sm text-slate-400 mb-6 leading-relaxed">
      Estás a punto de destruir la máquina
      <strong id="destroyModalVmName"
        class="text-white font-mono bg-slate-800 px-1.5 py-0.5 rounded"></strong>.<br /><br />
      Esta acción borrará el disco virtual de Proxmox y el estado de Terraform de forma
      <span class="text-red-400 font-semibold">irreversible</span>. ¿Deseas continuar?
    </p>

    <div class="flex justify-end gap-3">
      <button
        id="cancelDestroyBtn"
        class="px-4 py-2.5 rounded-lg text-sm font-medium bg-slate-800 hover:bg-slate-700
               text-slate-300 border border-slate-700 transition-colors"
      >
        Cancelar
      </button>
      <button
        id="confirmDestroyBtn"
        class="px-4 py-2.5 rounded-lg text-sm font-medium bg-red-600 hover:bg-red-500
               text-white transition-colors flex items-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        Sí, Destruir
      </button>
    </div>
  </div>
</dialog>
