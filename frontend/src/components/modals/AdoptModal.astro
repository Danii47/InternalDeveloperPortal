---
---

<dialog
  id="adoptModal"
  class="bg-slate-900 text-slate-300 rounded-xl border border-slate-800 shadow-2xl p-0
         backdrop:bg-black/70 backdrop:backdrop-blur-sm w-full max-w-lg m-auto
         open:animate-in open:fade-in-90 open:zoom-in-95"
>
  <div class="flex flex-col">

    <!-- Header -->
    <div class="p-6 border-b border-slate-800 flex justify-between items-center bg-slate-900/80">
      <div>
        <h3 class="text-xl font-bold text-white flex items-center gap-2">
          <svg class="w-5 h-5 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
          </svg>
          Adoptar VM al IDP
        </h3>
        <p class="text-xs text-slate-400 mt-1">
          Instancia: <span id="adoptVmName" class="font-mono text-violet-400 font-bold"></span>
        </p>
      </div>
      <button
        id="closeAdoptBtn"
        class="text-slate-500 hover:text-white transition-colors rounded-md p-1 hover:bg-slate-800 focus:outline-none"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="p-6 space-y-5">

      <!-- What will happen -->
      <div class="bg-violet-500/5 border border-violet-500/20 rounded-xl p-4 space-y-2">
        <p class="text-xs font-semibold text-violet-400 uppercase tracking-wider mb-2">Qué ocurrirá</p>
        <ul class="space-y-1.5 text-sm text-slate-300">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-violet-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/>
            </svg>
            Se creará un workspace de Terraform con el estado actual de la VM — <strong class="text-white">sin modificar nada</strong>.
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-violet-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/>
            </svg>
            Se añadirá el tag <code class="bg-slate-800 px-1.5 py-0.5 rounded text-violet-300 text-xs">managed-by-idp</code> a la VM en Proxmox.
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-violet-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/>
            </svg>
            Pasará a ser <strong class="text-white">Managed</strong>: podrás editar recursos, auditar drift y destruirla desde el IDP.
          </li>
        </ul>
      </div>

      <!-- Template selection -->
      <div class="space-y-2">
        <label class="block text-sm font-medium text-white">
          ¿Fue clonada de una plantilla?
          <span class="text-slate-500 font-normal ml-1">(opcional, pero necesaria para Reprovisionar SO)</span>
        </label>

        <div id="templateLoading" class="flex items-center gap-2 text-sm text-slate-500 py-2">
          <svg class="w-4 h-4 animate-spin text-violet-400" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
            <path class="opacity-75" fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
          </svg>
          Cargando plantillas disponibles...
        </div>

        <select
          id="adoptTemplateSelect"
          class="hidden w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white
                 focus:ring-2 focus:ring-violet-500/50 focus:border-violet-500 outline-none transition-all"
        >
          <option value="0">Sin plantilla / No lo sé</option>
        </select>

        <p id="templateHint" class="hidden text-[11px] text-slate-500 leading-relaxed">
          Si no sabes de qué plantilla viene, deja "Sin plantilla". Podrás usar Snapshots, editar recursos y destruir la VM. Solo perderás la capacidad de Reprovisionar SO.
        </p>
      </div>

      <!-- Error banner -->
      <div id="adoptError" class="hidden px-4 py-3 rounded-lg bg-red-500/10 border border-red-500/30 text-sm text-red-400"></div>

    </div>

    <!-- Footer -->
    <div class="p-6 border-t border-slate-800 bg-slate-900/50 flex justify-end gap-3 rounded-b-xl">
      <button
        id="cancelAdoptBtn"
        class="px-5 py-2.5 rounded-lg text-sm font-medium bg-slate-800 hover:bg-slate-700
               text-slate-300 border border-slate-700 transition-colors"
      >
        Cancelar
      </button>
      <button
        id="confirmAdoptBtn"
        class="px-6 py-2.5 rounded-lg text-sm font-medium bg-violet-600 hover:bg-violet-500
               disabled:bg-slate-700 disabled:cursor-not-allowed text-white transition-colors
               flex items-center gap-2 shadow-lg shadow-violet-900/20"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
        </svg>
        <span id="adoptBtnText">Adoptar VM</span>
      </button>
    </div>

  </div>
</dialog>

<script>
  import { apiFetch } from '@/lib/api.ts';

  // ── DOM refs ──────────────────────────────────────────────────────────
  const modal         = document.getElementById('adoptModal') as HTMLDialogElement;
  const closeBtn      = document.getElementById('closeAdoptBtn') as HTMLButtonElement;
  const cancelBtn     = document.getElementById('cancelAdoptBtn') as HTMLButtonElement;
  const confirmBtn    = document.getElementById('confirmAdoptBtn') as HTMLButtonElement;
  const btnText       = document.getElementById('adoptBtnText') as HTMLElement;
  const vmNameEl      = document.getElementById('adoptVmName') as HTMLElement;
  const templateSel   = document.getElementById('adoptTemplateSelect') as HTMLSelectElement;
  const templateLoad  = document.getElementById('templateLoading') as HTMLElement;
  const templateHint  = document.getElementById('templateHint') as HTMLElement;
  const errorEl       = document.getElementById('adoptError') as HTMLElement;

  // ── State ─────────────────────────────────────────────────────────────
  let currentVmName: string | null = null;
  let currentVmid: number | null = null;
  let currentNode: string | null = null;

  // ── Public opener ─────────────────────────────────────────────────────
  (window as any).openAdoptModal = (vmName: string, vmid: number, node: string) => {
    currentVmName = vmName;
    currentVmid   = vmid;
    currentNode   = node;
    vmNameEl.textContent = vmName;
    errorEl.classList.add('hidden');
    errorEl.textContent = '';
    templateSel.innerHTML = '<option value="0">Sin plantilla / No lo sé</option>';
    templateSel.classList.add('hidden');
    templateHint.classList.add('hidden');
    templateLoad.classList.remove('hidden');
    modal.showModal();
    loadTemplates(node);
  };

  [closeBtn, cancelBtn].forEach(b => b.addEventListener('click', () => modal.close()));

  // ── Load templates for the VM's node ─────────────────────────────────
  async function loadTemplates(node: string) {
    try {
      const res = await apiFetch(`/nodes/${node}/templates`);
      templateLoad.classList.add('hidden');

      if (res.ok) {
        const templates: Record<string, number> = await res.json();
        Object.entries(templates).forEach(([label, id]) => {
          const opt = document.createElement('option');
          opt.value = String(id);
          opt.textContent = label;
          templateSel.appendChild(opt);
        });
      }
      // Always show the select (even if empty — user can still pick "Sin plantilla")
      templateSel.classList.remove('hidden');
      templateHint.classList.remove('hidden');
    } catch {
      templateLoad.classList.add('hidden');
      templateSel.classList.remove('hidden');
      templateHint.classList.remove('hidden');
    }
  }

  // ── Confirm adoption ──────────────────────────────────────────────────
  confirmBtn.addEventListener('click', async () => {
    errorEl.classList.add('hidden');
    confirmBtn.disabled = true;
    btnText.textContent = 'Adoptando...';

    const templateId = parseInt(templateSel.value, 10) || 0;

    try {
      const res = await apiFetch('/adopt', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          vm_name: currentVmName,
          vmid: currentVmid,
          node_name: currentNode,
          template_id: templateId,
        }),
      });

      if (res.ok) {
        modal.close();
        // The TaskManager will pick up the task and show progress in the terminal
      } else {
        const data = await res.json().catch(() => ({}));
        errorEl.textContent = data.detail || 'Error al encolar la adopción.';
        errorEl.classList.remove('hidden');
        confirmBtn.disabled = false;
        btnText.textContent = 'Adoptar VM';
      }
    } catch {
      errorEl.textContent = 'Error de conexión al encolar la adopción.';
      errorEl.classList.remove('hidden');
      confirmBtn.disabled = false;
      btnText.textContent = 'Adoptar VM';
    }
  });
</script>
