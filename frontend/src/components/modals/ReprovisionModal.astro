---
// src/components/ReprovisionModal.astro
---

<dialog id="reprovisionModal" class="bg-slate-900 text-slate-300 rounded-xl border border-slate-800 shadow-2xl p-0 backdrop:bg-black/70 backdrop:backdrop-blur-sm w-full max-w-md m-auto open:animate-in open:fade-in-90 open:zoom-in-95">
  <form id="reprovisionForm" method="dialog" class="p-6">
    <div class="flex items-center gap-4 mb-4">
      <div class="w-10 h-10 rounded-full bg-purple-500/10 flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
      </div>
      <h3 class="text-lg font-bold text-white">Recreación Limpia (Nuke & Pave)</h3>
    </div>
    
    <p class="text-sm text-slate-400 mb-4 leading-relaxed">
      Estás a punto de reprovisionar la máquina <strong id="modalReprovisionVmName" class="text-white font-mono bg-slate-800 px-1.5 py-0.5 rounded"></strong>.
    </p>

    <div class="bg-purple-500/5 border border-purple-500/20 rounded-lg p-3 mb-5">
      <p class="text-[12px] text-purple-300 leading-relaxed">
        <strong class="text-purple-400">¿Qué ocurrirá?</strong> El disco virtual será destruido. Se desplegará una máquina idéntica conservando la IP, MAC y recursos.
      </p>
    </div>

    <div class="mb-6">
      <label class="block text-xs font-medium text-slate-400 mb-2">Nueva Contraseña del SO</label>
      <input type="password" id="reprovisionPassword" required placeholder="Contraseña segura..." class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white text-sm focus:ring-2 focus:ring-purple-500/50 focus:border-purple-500 outline-none transition-all">
    </div>

    <div class="flex justify-end gap-3">
      <button type="button" id="cancelReprovisionBtn" class="px-4 py-2.5 rounded-lg text-sm font-medium bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition-colors">
        Cancelar
      </button>
      <button type="submit" id="confirmReprovisionBtn" class="px-4 py-2.5 rounded-lg text-sm font-medium bg-purple-600 hover:bg-purple-500 text-white transition-colors flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        <span id="reprovisionBtnText">Sí, Reprovisionar</span>
      </button>
    </div>
  </form>
</dialog>

<script>
  import { apiFetch } from '@/lib/api.ts';

  const reprovisionModal = document.getElementById('reprovisionModal') as HTMLDialogElement;
  const form = document.getElementById('reprovisionForm') as HTMLFormElement;
  const modalReprovisionVmName = document.getElementById('modalReprovisionVmName');
  const cancelReprovisionBtn = document.getElementById('cancelReprovisionBtn');
  const confirmReprovisionBtn = document.getElementById('confirmReprovisionBtn') as HTMLButtonElement;
  const reprovisionBtnText = document.getElementById('reprovisionBtnText');
  const passwordInput = document.getElementById('reprovisionPassword') as HTMLInputElement;
  
  let vmToReprovision = null;
  let vmidToReprovision = null;
  let nodeToReprovision = null;

  window.openReprovisionModal = (vmName, vmid, node) => {
    vmToReprovision = vmName;
    vmidToReprovision = vmid;
    nodeToReprovision = node;
    modalReprovisionVmName.innerText = vmName;
    passwordInput.value = ""; // Limpiamos la contraseña al abrir
    reprovisionModal.showModal(); 
  };

  const closeModal = () => {
    reprovisionModal.close();
    vmToReprovision = null;
  };

  cancelReprovisionBtn.addEventListener('click', closeModal);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!vmToReprovision) return;

    const originalText = reprovisionBtnText.innerText;
    reprovisionBtnText.innerHTML = `<span class="animate-spin inline-block">⚙️</span> Reconstruyendo...`;
    confirmReprovisionBtn.disabled = true;
    cancelReprovisionBtn.disabled = true;
    passwordInput.disabled = true;

    try {
      const payload = {
        vm_name: vmToReprovision,
        vmid: vmidToReprovision,
        node_name: nodeToReprovision,
        admin_password: passwordInput.value
      };

      const res = await apiFetch('/reprovision', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!res.ok) {
        const err = await res.json();
        throw new Error(err.detail || "Error al reprovisionar");
      }

      closeModal();
      
    } catch (error) {
      alert(`Error crítico al reprovisionar: ${error.message}`);
      reprovisionBtnText.innerText = originalText;
      confirmReprovisionBtn.disabled = false;
      cancelReprovisionBtn.disabled = false;
      passwordInput.disabled = false;
    }
  });
</script>