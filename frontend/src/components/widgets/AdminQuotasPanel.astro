---
---

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-semibold text-white flex items-center gap-2">
        <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Pools del clúster
      </h2>
      <p class="text-sm text-slate-400 mt-0.5">Edita los límites de cada pool. La RAM se gestiona en GB.</p>
    </div>
    <button id="adminQuotasRefresh"
      class="text-xs text-slate-400 hover:text-white bg-slate-800 hover:bg-slate-700 px-3 py-1.5 rounded-lg border border-slate-700 transition-all flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
      </svg>
      Refrescar
    </button>
  </div>

  <div id="adminQuotasLoading" class="py-16 text-center text-slate-500 text-sm">
    <svg class="w-6 h-6 mx-auto mb-3 text-slate-600 animate-spin" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
    </svg>
    Cargando pools…
  </div>

  <div id="adminQuotasGrid" class="hidden grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
  </div>

  <div id="adminQuotasEmpty" class="hidden py-16 text-center text-slate-500 text-sm">
    No hay pools en el clúster.
  </div>
</div>

<div id="quotaSaveToast"
  class="fixed bottom-6 right-6 z-50 hidden bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 text-sm font-medium shadow-2xl">
</div>

<script>
  import { apiFetch } from '@/lib/api.ts';

  const grid = document.getElementById('adminQuotasGrid')!;
  const loadingEl = document.getElementById('adminQuotasLoading')!;
  const emptyEl = document.getElementById('adminQuotasEmpty')!;
  const toast = document.getElementById('quotaSaveToast')!;

  let toastTimer: ReturnType<typeof setTimeout> | null = null;

  function showToast(msg: string, ok: boolean) {
    toast.textContent = msg;
    toast.className = `fixed bottom-6 right-6 z-50 bg-slate-800 border rounded-xl px-4 py-3 text-sm font-medium shadow-2xl ${
      ok ? 'border-emerald-600 text-emerald-300' : 'border-red-600 text-red-300'
    }`;
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => { toast.classList.add('hidden'); }, 3000);
  }

  function _pct(used: number, max: number): string {
    if (max <= 0) return '0%';
    return `${Math.min(100, Math.round((used / max) * 100))}%`;
  }

  function _barCls(used: number, max: number): string {
    const p = max > 0 ? (used / max) * 100 : 0;
    if (p >= 90) return 'bg-red-500';
    if (p >= 75) return 'bg-orange-400';
    return 'bg-emerald-500';
  }

  function _fmtRam(mb: number): string {
    return mb >= 1024 ? `${(mb / 1024).toFixed(1)} GB` : `${mb} MB`;
  }

  const inputCls = 'w-16 bg-slate-950 border border-slate-700 rounded-lg px-2 py-1 text-center text-white text-sm focus:ring-1 focus:ring-blue-500 outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none';

  function buildCard(entry: any): HTMLDivElement {
    const { pool_name, quota, usage } = entry;
    const ramMaxGb = (quota.max_ram_mb / 1024).toFixed(1);
    const cpuPct = _pct(usage.cpu, quota.max_cpu);
    const ramPct = _pct(usage.ram_mb, quota.max_ram_mb);
    const diskPct = _pct(usage.disk_gb, quota.max_disk_gb);

    const card = document.createElement('div');
    card.className = 'bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-lg';
    card.dataset.pool = pool_name;

    card.innerHTML = `
      <div class="bg-slate-950/60 border-b border-slate-800 px-4 py-3 flex items-center justify-between gap-2">
        <span class="font-mono text-sm text-blue-300 truncate">${pool_name}</span>
        <button data-save="${pool_name}"
          class="shrink-0 text-xs bg-blue-600 hover:bg-blue-500 disabled:opacity-50 text-white px-3 py-1.5 rounded-lg transition-colors font-medium">
          Guardar
        </button>
      </div>

      <div class="p-4 space-y-4">

        <div class="space-y-1.5">
          <div class="flex items-center justify-between text-xs text-slate-400">
            <span class="font-medium uppercase tracking-wider text-slate-500">CPU</span>
            <div class="flex items-center gap-1.5">
              <span class="text-slate-300">${usage.cpu} usado /</span>
              <input data-field="max_cpu" type="number" min="1" value="${quota.max_cpu}" class="${inputCls}">
              <span class="text-slate-500">vCPU</span>
            </div>
          </div>
          <div class="h-1.5 bg-slate-800 rounded-full overflow-hidden">
            <div class="h-full rounded-full ${_barCls(usage.cpu, quota.max_cpu)}" style="width:${cpuPct}"></div>
          </div>
          <div class="text-right text-xs text-slate-600">${cpuPct} usado</div>
        </div>

        <div class="space-y-1.5">
          <div class="flex items-center justify-between text-xs text-slate-400">
            <span class="font-medium uppercase tracking-wider text-slate-500">RAM</span>
            <div class="flex items-center gap-1.5">
              <span class="text-slate-300">${_fmtRam(usage.ram_mb)} usado /</span>
              <input data-field="max_ram_gb" type="number" min="1" step="0.5" value="${ramMaxGb}" class="${inputCls}">
              <span class="text-slate-500">GB</span>
            </div>
          </div>
          <div class="h-1.5 bg-slate-800 rounded-full overflow-hidden">
            <div class="h-full rounded-full ${_barCls(usage.ram_mb, quota.max_ram_mb)}" style="width:${ramPct}"></div>
          </div>
          <div class="text-right text-xs text-slate-600">${ramPct} usado</div>
        </div>

        <div class="space-y-1.5">
          <div class="flex items-center justify-between text-xs text-slate-400">
            <span class="font-medium uppercase tracking-wider text-slate-500">Disco</span>
            <div class="flex items-center gap-1.5">
              <span class="text-slate-300">${usage.disk_gb.toFixed(1)} GB usado /</span>
              <input data-field="max_disk_gb" type="number" min="1" value="${quota.max_disk_gb}" class="${inputCls}">
              <span class="text-slate-500">GB</span>
            </div>
          </div>
          <div class="h-1.5 bg-slate-800 rounded-full overflow-hidden">
            <div class="h-full rounded-full ${_barCls(usage.disk_gb, quota.max_disk_gb)}" style="width:${diskPct}"></div>
          </div>
          <div class="text-right text-xs text-slate-600">${diskPct} usado</div>
        </div>

      </div>
    `;
    return card;
  }

  async function loadQuotas() {
    loadingEl.classList.remove('hidden');
    grid.classList.add('hidden');
    emptyEl.classList.add('hidden');
    try {
      const res = await apiFetch('/admin/quotas');
      if (!res.ok) return;
      const data: any[] = await res.json();
      loadingEl.classList.add('hidden');
      if (data.length === 0) {
        emptyEl.classList.remove('hidden');
        return;
      }
      grid.innerHTML = '';
      data.forEach(entry => grid.appendChild(buildCard(entry)));
      grid.classList.remove('hidden');
    } catch (_) {
      loadingEl.classList.add('hidden');
    }
  }

  grid.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('[data-save]') as HTMLElement | null;
    if (!btn) return;

    const poolName = btn.dataset.save!;
    const card = grid.querySelector(`[data-pool="${poolName}"]`) as HTMLElement;
    if (!card) return;

    const max_cpu = parseInt((card.querySelector('[data-field="max_cpu"]') as HTMLInputElement).value);
    const ram_gb = parseFloat((card.querySelector('[data-field="max_ram_gb"]') as HTMLInputElement).value);
    const max_disk_gb = parseInt((card.querySelector('[data-field="max_disk_gb"]') as HTMLInputElement).value);
    const max_ram_mb = Math.round(ram_gb * 1024);

    if ([max_cpu, max_ram_mb, max_disk_gb].some(v => isNaN(v) || v <= 0)) {
      showToast('Valores inválidos: todos los límites deben ser > 0', false);
      return;
    }

    btn.textContent = '…';
    btn.setAttribute('disabled', 'true');

    try {
      const res = await apiFetch(`/admin/quotas/${encodeURIComponent(poolName)}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ max_cpu, max_ram_mb, max_disk_gb }),
      });
      const data = await res.json();
      if (res.ok) {
        showToast(`Cuota de '${poolName}' guardada`, true);
      } else {
        showToast(data.detail ?? 'Error al guardar', false);
      }
    } catch (_) {
      showToast('Error de red', false);
    } finally {
      btn.textContent = 'Guardar';
      btn.removeAttribute('disabled');
    }
  });

  document.getElementById('adminQuotasRefresh')!.addEventListener('click', loadQuotas);

  loadQuotas();
</script>
