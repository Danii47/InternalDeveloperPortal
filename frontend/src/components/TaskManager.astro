---
---

<div id="taskManager" class="fixed bottom-6 right-6 z-50 flex flex-col-reverse gap-3 w-80 pointer-events-none">
</div>

<script>
  import { apiFetch } from '../lib/api.ts';
  const taskManager = document.getElementById('taskManager');
  
  let knownTasks = new Map(); 
  let activeTaskIds = new Set();
  let requiresReload = false;
  
  let isFirstLoad = true;

  const ICONS = {
    pending: `<svg class="w-5 h-5 animate-spin text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`,
    running: `<svg class="w-5 h-5 animate-spin text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`,
    completed: `<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`,
    failed: `<svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`
  };

  const STYLES = {
    pending: 'bg-slate-900 border-slate-700 text-slate-300',
    running: 'bg-blue-950/80 border-blue-500/30 text-blue-300',
    completed: 'bg-emerald-950/80 border-emerald-500/30 text-emerald-300',
    failed: 'bg-red-950/80 border-red-500/30 text-red-300'
  };

  async function pollTasks() {
    try {
      const res = await apiFetch('/tasks');
      if (!res.ok) return;
      const tasks = await res.json();
      renderTasks(tasks);
    } catch (e) {
      console.error("Error contactando con el Task Manager", e);
    }
  }

  function renderTasks(tasks) {
    const now = Date.now();
    let currentActiveCount = 0;

    tasks.forEach(task => {
      if (task.status === 'completed' || task.status === 'failed') {
        if (!knownTasks.has(task.id)) {
          knownTasks.set(task.id, isFirstLoad ? 0 : now);
        }
      }

      const isExpired = knownTasks.has(task.id) && (now - knownTasks.get(task.id) > 6000);
      if (isExpired) {
        const existingEl = document.getElementById(`task-${task.id}`);
        if (existingEl) existingEl.remove();
        return;
      }

      if (task.status === 'pending' || task.status === 'running') {
        currentActiveCount++;
        activeTaskIds.add(task.id);
      } else if (task.status === 'completed') {
        if (activeTaskIds.has(task.id)) {
          requiresReload = true;
          activeTaskIds.delete(task.id); 
        }
      } else if (task.status === 'failed') {
        activeTaskIds.delete(task.id);
      }

      let taskEl = document.getElementById(`task-${task.id}`);
      const currentRenderedStatus = taskEl ? taskEl.getAttribute('data-status') : null;

      if (!taskEl || currentRenderedStatus !== task.status) {
        
        if (!taskEl) {
          taskEl = document.createElement('div');
          taskEl.id = `task-${task.id}`;
          taskManager.appendChild(taskEl);
        }

        taskEl.setAttribute('data-status', task.status);
        taskEl.className = `pointer-events-auto flex items-start gap-3 p-4 rounded-xl border shadow-2xl backdrop-blur-md transition-all duration-500 animate-in slide-in-from-right-8 ${STYLES[task.status]}`;
        
        taskEl.innerHTML = `
          <div class="mt-0.5 flex-shrink-0">${ICONS[task.status]}</div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-bold text-white truncate capitalize">${task.type}</p>
            <p class="text-xs truncate opacity-80 mt-0.5">${task.target}</p>
            ${task.status === 'running' ? `<p class="text-[10px] uppercase tracking-wider font-bold text-blue-400 mt-2 animate-pulse">Ejecutando Terraform...</p>` : ''}
            ${task.status === 'failed' ? `<p class="text-[10px] text-red-400 mt-2 leading-relaxed bg-red-950/50 p-2 rounded border border-red-500/20">${task.error}</p>` : ''}
          </div>
        `;
      }
    });

    isFirstLoad = false;

    if (requiresReload && currentActiveCount === 0) {
      requiresReload = false;
      setTimeout(() => {
        window.location.reload();
      }, 2000); 
    }
  }

  setInterval(pollTasks, 1500);
  pollTasks();
</script>